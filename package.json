{
  "name": "yappik",
  "private": true,
  "version": "1.0.0",
  "description": "Yappik - A fast-paced, voice-driven photo guessing duel. See the photo, shout the answer before your clock runs dry.",
  "homepage": "https://albertorosati.github.io/yappik/",
  "repository": {
    "type": "git",
    "url": "https://github.com/albertorosati/yappik.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "catalog:vision": "python3 scripts/vision-curator/curate_catalog.py",
    "catalog:gallery": "python3 scripts/vision-curator/curate_catalog.py --gallery-only"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
